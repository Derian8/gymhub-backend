DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
DB_NAME=gymhub
DB_USER=gymhub_user
DB_PASSWORD=gymhub_pass
DB_HOST=db
DB_PORT=5432
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Para usar tu propia API key de OpenAI, reemplaza la EMERGENT_LLM_KEY y agrega tu clave:
# OPENAI_API_KEY=sk-your-openai-api-key-here
# Deja EMERGENT_LLM_KEY vacío si usas tu propia OPENAI_API_KEY
EMERGENT_LLM_KEY=sk-emergent-your-key-here
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=300
AI_DAILY_LIMIT_PER_USER=20
INACTIVITY_DAYS_THRESHOLD=30
PAYMENT_GRACE_DAYS=7
DEFAULT_FROM_EMAIL=noreply@gymhub.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
