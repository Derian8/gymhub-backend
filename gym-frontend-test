#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOCKER_BIN="docker"
COMPOSE_FILE="docker-compose.frontend-test.yml"

if ! docker ps >/dev/null 2>&1; then
  DOCKER_BIN="/mnt/c/Program Files/Docker/Docker/resources/bin/docker.exe"
fi

if ! command -v docker >/dev/null 2>&1 && [ ! -x "${DOCKER_BIN}" ]; then
  echo "Docker no está instalado o no está disponible en PATH."
  exit 1
fi

if [ ! -f "${ROOT_DIR}/frontend/package.json" ]; then
  echo "No se encontró frontend/package.json."
  exit 1
fi

if [ ! -f "${ROOT_DIR}/${COMPOSE_FILE}" ]; then
  echo "No se encontró ${ROOT_DIR}/${COMPOSE_FILE}."
  exit 1
fi

TEST_TARGET="${*:-}"
if [ -n "${TEST_TARGET}" ]; then
  TEST_CMD="npm run test -- ${TEST_TARGET}"
else
  TEST_CMD="npm run test"
fi

cd "${ROOT_DIR}"
"${DOCKER_BIN}" compose -f "${COMPOSE_FILE}" run --rm frontend-test sh -lc "${TEST_CMD}"
