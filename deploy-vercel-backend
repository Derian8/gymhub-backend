#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${ROOT_DIR}/.env.supabase-vercel.local"
PROJECT_FILE="${ROOT_DIR}/gymhub/.vercel/project.json"

if [[ ! -f "${ENV_FILE}" ]]; then
  echo "Falta ${ENV_FILE}" >&2
  exit 1
fi

set -a
source "${ENV_FILE}"
set +a

: "${VERCEL_TOKEN:?Falta VERCEL_TOKEN}"
: "${VERCEL_TEAM_ID:?Falta VERCEL_TEAM_ID}"
: "${VERCEL_BACKEND_PROJECT_ID:?Falta VERCEL_BACKEND_PROJECT_ID}"
: "${VERCEL_BACKEND_PROJECT_NAME:?Falta VERCEL_BACKEND_PROJECT_NAME}"

if [[ ! -f "${PROJECT_FILE}" ]]; then
  echo "Falta ${PROJECT_FILE}. Ejecuta vercel link dentro de gymhub/." >&2
  exit 1
fi

PROJECT_NAME_LOCAL="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["projectName"])' "${PROJECT_FILE}")"
PROJECT_ID_LOCAL="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["projectId"])' "${PROJECT_FILE}")"

if [[ "${PROJECT_NAME_LOCAL}" != "${VERCEL_BACKEND_PROJECT_NAME}" ]]; then
  echo "gymhub/.vercel/project.json apunta a ${PROJECT_NAME_LOCAL}, no a ${VERCEL_BACKEND_PROJECT_NAME}." >&2
  exit 1
fi

if [[ "${PROJECT_ID_LOCAL}" != "${VERCEL_BACKEND_PROJECT_ID}" ]]; then
  echo "gymhub/.vercel/project.json usa ${PROJECT_ID_LOCAL}, no ${VERCEL_BACKEND_PROJECT_ID}." >&2
  exit 1
fi

echo "Deploy backend -> ${VERCEL_BACKEND_PROJECT_NAME} (${VERCEL_BACKEND_PROJECT_ID})"

cd "${ROOT_DIR}/gymhub"

VERCEL_PROJECT_ID="${VERCEL_BACKEND_PROJECT_ID}" \
VERCEL_PROJECT_NAME="${VERCEL_BACKEND_PROJECT_NAME}" \
npx vercel@latest deploy . \
  --yes \
  --token "${VERCEL_TOKEN}" \
  --scope "${VERCEL_TEAM_ID}" \
  --prod
