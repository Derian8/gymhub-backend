{
  "rewrites": [
    {
      "source": "/auth/(.*)",
      "destination": "https://proyectoappgym-backend.vercel.app/auth/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://proyectoappgym-backend.vercel.app/api/$1"
    },
    {
      "source": "/health/(.*)",
      "destination": "https://proyectoappgym-backend.vercel.app/health/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://proyectoappgym-backend.vercel.app/media/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
