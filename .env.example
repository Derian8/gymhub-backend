DJANGO_SECRET_KEY=dev-secret-key-change-me-2026-32chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend,host.docker.internal
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://host.docker.internal:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://host.docker.internal:3000
USE_X_FORWARDED_HOST=False
USE_X_FORWARDED_PROTO=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax

# Supabase PostgreSQL. Usa el Session Pooler recomendado para aplicaciones persistentes.
# Ejemplo:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DB_SSLMODE=require
DB_CONN_MAX_AGE=60

# Alternativa si prefieres no usar DATABASE_URL.
DB_NAME=postgres
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=replace-with-supabase-db-password
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

AI_PROVIDER=deterministic
AI_LOCAL_BACKEND=ollama
AI_LOCAL_MODEL=llama3.2:3b
AI_LOCAL_BASE_URL=http://host.docker.internal:11434
AI_LOCAL_TIMEOUT_MS=2500
OPENAI_API_KEY=
EMERGENT_LLM_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=300
AI_DAILY_LIMIT_PER_USER=20
AI_DAILY_LIMIT_MEMBER=20
AI_DAILY_LIMIT_TRAINER=60
AI_CHAT_HISTORY_WINDOW=10

INACTIVITY_DAYS_THRESHOLD=30
PAYMENT_GRACE_DAYS=7
DEFAULT_FROM_EMAIL=noreply@gymhub.com

VITE_API_BASE_URL=
VITE_PROXY_TARGET=http://backend:8000
VITE_API_TIMEOUT_MS=15000
