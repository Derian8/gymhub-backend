# Producción local validada por Docker. Para staging o internet real,
# cambia las banderas SECURE_* y *_COOKIE_SECURE a True y configura hosts/orígenes reales.
DJANGO_SECRET_KEY=change-this-production-secret-key-2026
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,host.docker.internal
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://host.docker.internal:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://host.docker.internal:3000
USE_X_FORWARDED_HOST=False
USE_X_FORWARDED_PROTO=False
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
AUTH_COOKIE_SECURE=False
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_PATH=/
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=False
CSRF_COOKIE_SAMESITE=Lax

# Supabase PostgreSQL. Usa el Session Pooler recomendado para aplicaciones persistentes.
# Ejemplo:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
DB_DISABLE_SERVER_SIDE_CURSORS=True

# Alternativa si prefieres no usar DATABASE_URL.
DB_NAME=postgres
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=replace-with-supabase-db-password
DB_HOST=aws-0-region.pooler.supabase.com
DB_PORT=5432

REDIS_URL=redis://redis:6379
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

USE_S3_STORAGE=False
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=gymhub-media
S3_ENDPOINT_URL=https://PROJECT_REF.supabase.co/storage/v1/s3
S3_REGION=us-west-2
S3_URL_EXPIRATION=900

OPENAI_API_KEY=
EMERGENT_LLM_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_MAX_TOKENS=300
AI_DAILY_LIMIT_PER_USER=20

INACTIVITY_DAYS_THRESHOLD=30
PAYMENT_GRACE_DAYS=7
DEFAULT_FROM_EMAIL=noreply@gymhub.com
CRON_SECRET=

DEMO_TRAINER_PASSWORD=
DEMO_MEMBER_PASSWORD=

# Déjalo vacío cuando frontend y backend compartan el mismo origen vía Nginx proxy.
# Define una URL absoluta solo si el frontend se desplegará contra otro dominio/API.
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=15000
